# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
# El código habla con cualquier proveedor compatible con la API de chat completions de OpenAI;
# cambiar de proveedor = cambiar estas 3 variables.

# --- Opción B (recomendada con 8 GB de RAM): Groq, free tier ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Elige el modelo desde la consola del proveedor (el catálogo cambia). Pequeño/rápido para iterar.
LLM_MODEL=

# --- Opción A (local, si tu RAM lo permite): Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<modelo pequeño, p. ej. de ~1B parámetros con 8 GB de RAM>

# Embeddings locales
EMBED_MODEL=intfloat/multilingual-e5-small

# Tope de seguridad por script (tokens de salida)
MAX_OUTPUT_TOKENS=512
